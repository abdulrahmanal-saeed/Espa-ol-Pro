   "turns": [
    {
     "id": "dlg_a1_recepcion.t1",
     "speaker": "recepcion",
     "es": "Buenos días, señor. Bienvenido. ¿En qué puedo ayudarle?",
     "ar": "صباح الخير يا سيدي. أهلاً وسهلاً. كيف يمكنني مساعدة حضرتك؟",
     "en": "Good morning, sir. Welcome. How can I help you?"
    },
    {
     "id": "dlg_a1_recepcion.t2",
     "speaker": "garcia",
     "es": "Buenos días. Me llamo Pablo García. Soy cliente de la empresa.",
     "ar": "صباح الخير. اسمي بابلو غارسيا. أنا عميل لدى الشركة.",
     "en": "Good morning. My name is Pablo García. I'm a client of the company."
    },
    {
     "id": "dlg_a1_recepcion.t3",
     "speaker": "recepcion",
     "es": "Mucho gusto, señor García. Le presento a Laura Pérez, gerente de ventas.",
     "ar": "تشرّفنا يا سيد غارسيا. أقدّم لحضرتك لاورا بيريز، مديرة المبيعات.",
     "en": "Nice to meet you, Mr. García. Let me introduce you to Laura Pérez, sales manager."
    },
    {
     "id": "dlg_a1_recepcion.t4",
     "speaker": "perez",
     "es": "Es un placer, señor García.",
     "ar": "تشرّفت يا سيد غارسيا.",
     "en": "It's a pleasure, Mr. García."
    },
    {
     "id": "dlg_a1_recepcion.t5",
     "speaker": "garcia",
     "es": "El placer es mío. Aquí tiene mi tarjeta.",
     "ar": "الشرف لي. تفضّلي بطاقتي.",
     "en": "The pleasure is mine. Here is my card."
    }
