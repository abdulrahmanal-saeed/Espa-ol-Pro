 "grammar": [
  {
   "id": "g_time",
   "title_ar": "الساعة: es la una / son las…",
   "body_ar": "نسأل: ¿Qué hora es? (كم الساعة؟)\nللواحدة: Es la una. ولباقي الساعات: Son las dos، Son las tres…\n\nالدقائق: y cuarto (والربع)، y media (والنصف)، menos cuarto (إلا ربعاً)، y diez (وعشر دقائق).\nSon las ocho y media — الثامنة والنصف. Son las nueve menos cuarto — التاسعة إلا ربعاً.\n\nلموعد: ¿A qué hora…? — A las diez. (في العاشرة)",
   "examples": [
    {
     "es": "Es la una y media.",
     "ar": "الساعة الواحدة والنصف."
    },
    {
     "es": "Son las tres en punto.",
     "ar": "الساعة الثالثة تماماً."
    },
    {
     "es": "La reunión es a las diez.",
     "ar": "الاجتماع في العاشرة."
    }
   ]
  },
  {
   "id": "g_days",
   "title_ar": "أيام الأسبوع",
   "body_ar": "lunes، martes، miércoles، jueves، viernes، sábado، domingo.\nتُكتب بحرف صغير. ونقول «يوم الاثنين» بأداة التعريف بلا حرف جر: el lunes.\nوللتكرار نجمع الأداة: los lunes (كل اثنين).\n\nانتبه: الأسبوع في إسبانيا وأمريكا اللاتينية يبدأ عملياً بالاثنين، وعطلته غالباً السبت والأحد.",
   "examples": [
    {
     "es": "La reunión es el martes.",
     "ar": "الاجتماع يوم الثلاثاء."
    },
    {
     "es": "Los viernes trabajo en casa.",
     "ar": "أعمل من البيت أيام الجمعة."
    }
   ]
  },
  {
   "id": "g_present_regular",
   "title_ar": "المضارع المنتظم مع yo",
   "body_ar": "مع yo تنتهي كل الأفعال المنتظمة بـ ‎-o:\ndesayunar ← desayuno · llegar ← llego · comer ← como · cenar ← ceno · terminar ← termino\n\nوفعل levantarse انعكاسي: me levanto (أستيقظ وأنهض).\nانتبه: como (آكل) بلا علامة، و¿cómo? (كيف؟) بعلامة.",
   "examples": [
    {
     "es": "Desayuno a las siete.",
     "ar": "أفطر في السابعة."
    },
    {
     "es": "Como con mis compañeros.",
     "ar": "آكل مع زملائي."
    }
   ]
  },
  {
   "id": "g_appointments",
   "title_ar": "تحديد موعد بأدب",
   "body_ar": "للاقتراح الرسمي: ¿Le va bien el lunes a las diez? (هل يناسب حضرتك الاثنين في العاشرة؟)\nوبين الزملاء: ¿Te va bien…?\n\nللقبول: Sí, perfecto. / De acuerdo. / Vale (في إسبانيا).\nللاعتذار: Lo siento, el lunes estoy ocupado.",
   "examples": [
    {
     "es": "¿Le va bien el jueves?",
     "ar": "هل يناسب حضرتك الخميس؟"
    },
    {
     "es": "De acuerdo, nos vemos el jueves.",
     "ar": "اتفقنا، نلتقي الخميس."
    }
   ]
  }
 ],
