{
 "unit": "pa1_u3",
 "grammar": [
  {
   "id": "g_numbers",
   "title_ar": "الأرقام من 0 إلى 20",
   "body_ar": "0 cero · 1 uno · 2 dos · 3 tres · 4 cuatro · 5 cinco · 6 seis · 7 siete · 8 ocho · 9 nueve · 10 diez\n11 once · 12 doce · 13 trece · 14 catorce · 15 quince\n16 dieciséis · 17 diecisiete · 18 dieciocho · 19 diecinueve · 20 veinte\n\nمن 16 إلى 19 النمط ثابت: dieci + الرقم (أي «عشرة و…»). وكلمة dieciséis وحدها تحمل علامة نبر.\n\nرقم الهاتف يُقرأ عادةً رقماً رقماً أو أزواجاً.",
   "examples": [
    {
     "es": "Mi número es cinco, cero, uno.",
     "ar": "رقمي هو ٥ ٠ ١."
    }
   ]
  },
  {
   "id": "g_ser",
   "title_ar": "الفعل ser (يكون) في المفرد",
   "body_ar": "yo soy — أنا\ntú eres — أنتَ / أنتِ\nél / ella / usted es — هو / هي / حضرتك\n\n• العربية تقول «أنا عمر» بلا فعل، أما الإسبانية فلا بد فيها من الفعل: Soy Omar.\n• الضمير يُحذف غالباً لأن الفعل يدل عليه: «Soy Omar» أشيع من «Yo soy Omar».\n• نستعمل ser للهوية والاسم والجنسية والأصل والمهنة.",
   "examples": [
    {
     "es": "Soy Omar.",
     "ar": "أنا عمر."
    },
    {
     "es": "¿Eres de México?",
     "ar": "هل أنت من المكسيك؟"
    },
    {
     "es": "Ella es Laura.",
     "ar": "هي لاورا."
    }
   ]
  },
  {
   "id": "g_negation",
   "title_ar": "النفي بـ no",
   "body_ar": "للنفي نضع no قبل الفعل مباشرة — ولا شيء غير ذلك:\nSoy de España. ← No soy de España.\n\nوفي الإجابة بالنفي تتكرر no: مرة بمعنى «لا» ومرة لنفي الفعل:\n¿Eres de México? — No, no soy de México.",
   "examples": [
    {
     "es": "No soy de España.",
     "ar": "لست من إسبانيا."
    },
    {
     "es": "No, no soy Laura.",
     "ar": "لا، لست لاورا."
    }
   ]
  }
 ],
