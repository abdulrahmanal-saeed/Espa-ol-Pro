 "unit": "a2_u4",
 "grammar": [
  {
   "id": "g_gustar",
   "title_ar": "gustar: «يعجبني»",
   "body_ar": "في gustar الشيء هو الفاعل، والشخص قبل الفعل:\nme gusta + مفرد أو مصدر: Me gusta el café. · Me gusta viajar.\nme gustan + جمع: Me gustan los idiomas.\n\nme (لي) · te (لك) · le (له / لها / لحضرتك) · nos (لنا) · les (لهم)\nencantar مثل gustar وأقوى: Me encanta = يعجبني جداً.\n\nللموافقة: A mí también (وأنا أيضاً) · A mí tampoco (وأنا أيضاً لا).",
   "examples": [
    {
     "es": "¿Te gustan las reuniones largas?",
     "ar": "هل تعجبك الاجتماعات الطويلة؟"
    },
    {
     "es": "A Laura le gusta trabajar en equipo.",
     "ar": "لاورا يعجبها العمل الجماعي."
    }
   ]
  },
  {
   "id": "g_preferir",
   "title_ar": "preferir، و¿Cuál?، وeste / ese",
   "body_ar": "preferir e ← ie: prefiero · prefieres · prefiere · preferimos · prefieren\nPrefiero el modelo negro. · Prefiero trabajar por la mañana.\n\n¿Cuál prefieres? للاختيار بين أشياء محدّدة؛ ¿Qué prefieres? أعمّ.\neste / esta = هذا / هذه (قريب) · ese / esa = ذلك / تلك (أبعد قليلاً).\nالألوان صفات تتّفق مع الاسم: el móvil negro · la mesa blanca · los coches azules.",
   "examples": [
    {
     "es": "¿Cuál prefieres, este o ese?",
     "ar": "أيّهما تفضّل، هذا أم ذلك؟"
    },
    {
     "es": "Prefiero esa, la blanca.",
     "ar": "أفضّل تلك، البيضاء."
    }
   ]
  },
  {
   "id": "g_comparison",
   "title_ar": "المقارنة",
   "body_ar": "más + صفة + que: Este portátil es más rápido que ese.\nmenos + صفة + que: Es menos caro que el otro.\ntan + صفة + como (المساواة): Es tan bueno como el otro.\n\nشاذّة: mejor (أفضل) وpeor (أسوأ)، وليس más bueno / más malo:\nEsta oferta es mejor que la otra.\nالصفة تتّفق مع الاسم: La mesa es más grande. · Los móviles son más caros.",
   "examples": [
    {
     "es": "Madrid es más grande que Toledo.",
     "ar": "مدريد أكبر من طليطلة."
    },
    {
     "es": "El tren es tan rápido como el avión.",
     "ar": "القطار سريع مثل الطائرة."
    }
   ]
  },
  {
   "id": "g_opinion",
   "title_ar": "إبداء الرأي",
   "body_ar": "Creo que… · Pienso que… · En mi opinión… · Me parece + صفة\nCreo que es una buena idea. — أظن أنها فكرة جيدة.\nMe parece caro. — يبدو لي غالياً.\n\nالموافقة: Estoy de acuerdo. · Tienes razón.\nالاعتراض بأدب: No estoy de acuerdo, porque… · Depende.\n(بعد no creo que يأتي زمن آخر ستتعلّمه في B1؛ الآن استعمل creo que في الإثبات.)",
   "examples": [
    {
     "es": "En mi opinión, el precio es muy alto.",
     "ar": "في رأيي، السعر مرتفع جداً."
    },
    {
     "es": "Tienes razón, es mejor esperar.",
     "ar": "معك حق، من الأفضل أن ننتظر."
    }
   ]
  },
  {
   "id": "g_superlative",
   "title_ar": "التفضيل الأعلى والتوصية",
   "body_ar": "el / la / los / las + más + صفة (+ de): el más barato · la más rápida de las tres.\nشاذّ: el mejor / la mejor · el peor / la peor: la mejor opción.\n\nrecomendar e ← ie: Recomiendo la oferta de Sol.\naunque = مع أنّ: Recomiendo esta, aunque es más cara.",
   "examples": [
    {
     "es": "Es la oferta más completa.",
     "ar": "إنه العرض الأكثر اكتمالاً."
    },
    {
     "es": "Recomiendo el proveedor de Madrid, aunque es más caro.",
     "ar": "أوصي بمورّد مدريد، مع أنه أغلى."
    }
   ]
  }
