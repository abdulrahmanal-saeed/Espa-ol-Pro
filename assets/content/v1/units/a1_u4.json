{
 "unit": "a1_u4",
 "grammar": [
  {
   "id": "g_querer",
   "title_ar": "الفعل querer (يريد)",
   "body_ar": "querer فعل شاذّ: يتغيّر e إلى ie في جذره:\nyo quiero · tú quieres · él/ella/usted quiere\n\nللطلب المهذّب في المقهى أو المطعم: Quiero un café, por favor.\nوأكثر تهذيباً: Quisiera un café (أودّ…) — للاستعمال الرسمي.\nبعده اسم (Quiero agua) أو فعل بالمصدر (Quiero pagar).",
   "examples": [
    {
     "es": "Quiero un té, por favor.",
     "ar": "أريد شاياً من فضلك."
    },
    {
     "es": "¿Quieres agua?",
     "ar": "هل تريد ماءً؟"
    },
    {
     "es": "¿Qué quiere usted?",
     "ar": "ماذا تريد حضرتك؟"
    }
   ]
  },
  {
   "id": "g_articles_food",
   "title_ar": "un / una ومقادير الطعام",
   "body_ar": "un مع المذكر وuna مع المؤنث: un café، una ensalada.\nللمشروبات والأطعمة غير المعدودة غالباً بلا أداة: Quiero agua. ¿Tienes leche?\n\nانتبه: el agua مؤنثة رغم el (لأنها تبدأ بـ a مشدّدة): el agua fría.",
   "examples": [
    {
     "es": "Un café y una botella de agua.",
     "ar": "قهوة وزجاجة ماء."
    },
    {
     "es": "No quiero carne.",
     "ar": "لا أريد لحماً."
    }
   ]
  },
  {
   "id": "g_prices",
   "title_ar": "الأسعار والأعداد الكبيرة",
   "body_ar": "treinta، cuarenta، cincuenta (50)، cien (100).\nبين العشرات والآحاد نضع y: cincuenta y cinco (55). ولا نضعها بعد المئة: ciento cinco (105).\n\nللسؤال: ¿Cuánto cuesta? (لشيء واحد) / ¿Cuánto es? (للمجموع عند الدفع).\nالجواب: Cuesta diez euros. / Son veinte euros.",
   "examples": [
    {
     "es": "¿Cuánto cuesta el menú? — Doce euros.",
     "ar": "كم سعر الوجبة؟ — اثنا عشر يورو."
    },
    {
     "es": "Son cincuenta euros.",
     "ar": "المجموع خمسون يورو."
    }
   ]
  },
  {
   "id": "g_necesitar",
   "title_ar": "necesito + اسم أو فعل",
   "body_ar": "necesitar فعل منتظم من نوع ‎-ar: necesito، necesitas، necesita.\nNecesito una factura. — أحتاج فاتورة.\nNecesito pagar. — أحتاج أن أدفع.\n\nمفيد جداً في العمل: يعبّر عن الحاجة دون أن يكون أمراً.",
   "examples": [
    {
     "es": "Necesitamos agua para la reunión.",
     "ar": "نحتاج ماءً للاجتماع."
    },
    {
     "es": "¿Necesita una factura?",
     "ar": "هل تحتاج حضرتك فاتورة؟"
    }
   ]
  }
 ],
