# Español Pro — Phase 1 needs NO environment variables and NO secrets.
# The app is fully offline: no backend, no API keys, no analytics.
#
# Phase 2 (AI tutor) will talk to a small backend proxy. Keys live ONLY on
# that backend, never in the Flutter app and never in this repository:
#
# AI_PROXY_BASE_URL=https://<your-backend>/v1   # public URL, not a secret
# (the LLM provider key is configured in the backend's secret store)
